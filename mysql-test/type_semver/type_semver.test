CREATE TABLE t (v SEMVER NOT NULL, KEY(v));
INSERT INTO t VALUES ('10.0.0'), ('2.0.0'), ('1.2.3'),
                     ('2.0.0-rc.1+build.42'), ('2.0.0-alpha');
SELECT v, SEMVER_MAJOR(v), SEMVER_MINOR(v), SEMVER_PATCH(v),
       SEMVER_PRERELEASE(v), SEMVER_BUILD(v) FROM t ORDER BY v;
SELECT SEMVER_IS_VALID('1.0.0'), SEMVER_IS_VALID('01.0.0'),
       SEMVER_IS_VALID('1.0');
SELECT SEMVER_COMPARE('1.0.0-alpha', '1.0.0'),
       SEMVER_COMPARE('1.0.0+one', '1.0.0+two');
SELECT SEMVER_SATISFIES('1.5.0', '>=1.2.0 <2.0.0'),
       SEMVER_SATISFIES('2.0.0', '^1.5.0'),
       SEMVER_SATISFIES('1.2.9', '1.2.x');
SELECT SEMVER_NORMALIZE(' v1.2 '),
       SEMVER_BUMP_MAJOR('1.2.3-rc.1+42'),
       SEMVER_BUMP_MINOR('1.2.3-rc.1+42'),
       SEMVER_BUMP_PATCH('1.2.3-rc.1+42');
DROP TABLE t;
